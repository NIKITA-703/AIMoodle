LOGIN=
PASSWORD=

# Необязательно. Оставьте пустым, если Chrome установлен стандартно.
CHROME_BINARY_PATH=

# Адрес OpenAI-совместимого API LM Studio.
LM_STUDIO_BASE_URL=http://localhost:1234

# Сколько попыток тестов бот может отправить за один запуск.
TESTS_LIMIT=1

# Число разных курсов, обрабатываемых одновременно (1-4).
# Каждый worker закрепляется за отдельным курсом и делит общий TESTS_LIMIT.
PARALLEL_WORKERS=1

# true: разрешить боту автоматически использовать последнюю доступную попытку.
# false: остановиться перед последней попыткой и оставить решение пользователю.
AUTO_USE_LAST_ATTEMPT=false

# true: не начинать новый тематический тест, если лекция не извлечена.
# false: решать без лекции на общих знаниях ИИ.
REQUIRE_LECTURE_CONTEXT=false
